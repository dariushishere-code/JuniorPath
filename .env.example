# Copy this file to `.env` and fill in your own Supabase project values:
#   cp .env.example .env
#
# The ANON/PUBLISHABLE key is safe to expose in the browser (protected by RLS).
# NEVER put the service role (secret) key in the client.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key